{
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "regions": ["fra1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.monopatinmonkey.com" }],
      "destination": "https://monopatinmonkey.com/:path*",
      "permanent": true
    }
  ]
}
