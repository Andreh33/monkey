{
  "framework": "nextjs",
  "buildCommand": "prisma generate && node scripts/migrate-checkout.mjs && node scripts/migrate-vehicle-categories.mjs && node scripts/increase-prices-20261109.mjs && node scripts/migrate-catalog-indexes.mjs && next build",
  "installCommand": "npm install",
  "regions": ["fra1"],
  "redirects": [
    {
      "source": "/tienda/taller",
      "destination": "/reparaciones",
      "permanent": true
    },
    {
      "source": "/tienda/patinete-electrico-etric-vortex",
      "destination": "/tienda/patinete-electrico-etric-vortex-un-motor",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.monopatinmonkey.com" }],
      "destination": "https://monopatinmonkey.com/:path*",
      "permanent": true
    }
  ]
}
