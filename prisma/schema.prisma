generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  phone     String?
  role      String    @default("CLIENT")
  addresses Address[]
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  fullName   String
  street     String
  city       String
  postalCode String
  country    String  @default("España")
  phone      String?
  isDefault  Boolean @default(false)
}

model Product {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String
  shortDesc   String
  price       Float
  compareAt   Float?
  currency    String         @default("EUR")
  sku         String?        @unique
  stock       Int            @default(0)
  category    String
  brand       String?
  maxSpeed    Int?
  range       Int?
  motorPower  Int?
  battery     String?
  weight      Float?
  maxLoad     Int?
  stripeLink  String
  shippingCost Float?
  shippingCountries String?
  youtubeUrl  String?
  subcategory String?
  featured    Boolean        @default(false)
  active      Boolean        @default(true)
  images      ProductImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([active, createdAt(sort: Desc), id])
  @@index([active, category, createdAt(sort: Desc), id])
  @@index([active, category, featured(sort: Desc), createdAt(sort: Desc)])
  @@index([active, category, subcategory])
  @@index([active, brand])
  @@index([active, price, id])
  @@index([active, name, id])
}

model Category {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  order         Int           @default(0)
  subcategories Subcategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug       String
  name       String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, slug])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int     @default(0)

  @@index([productId, order])
}

model Order {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  status    String   @default("PENDING")
  total     Float
  items     String
  stripeRef String?
  firstName String?
  lastName String?
  phone String?
  addressLine1 String?
  addressLine2 String?
  city String?
  region String?
  postalCode String?
  country String?
  subtotalCents Int?
  shippingCents Int?
  totalCents Int?
  currency String @default("EUR")
  fulfillmentStatus String @default("UNFULFILLED")
  checkoutTokenHash String? @unique
  requestHash String?
  stripeRequestEncrypted String?
  reservationOwnerHash String?
  stripeLiveMode Boolean?
  stripeSessionId String? @unique
  stripePaymentIntentId String?
  expiresAt DateTime?
  reconciliationCheckedAt DateTime?
  paidAt DateTime?
  stockReleased Boolean @default(false)
  stockIssue Boolean @default(false)
  locale String @default("es")
  createdAt DateTime @default(now())

  @@index([status, expiresAt])
  @@index([status, paidAt, id])
  @@index([reservationOwnerHash, status])
}

model CheckoutEvent {
  id String @id
  type String
  orderId String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model RepairRequest {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String
  scooterBrand String
  scooterModel String?
  problem      String
  problemType  String
  preferred    String?
  status       String   @default("NEW")
  notes        String?
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}

model ScooterRegistrationRequest {
  id            String                        @id @default(cuid())
  holderName    String
  email         String
  phone         String
  dni           String
  noCertificate Boolean                       @default(false)
  documents     ScooterRegistrationDocument[]
  createdAt     DateTime                      @default(now())
}

model ScooterRegistrationDocument {
  id           String                     @id @default(cuid())
  requestId    String
  request      ScooterRegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  pathname     String
  originalName String
  contentType  String
  size         Int
  createdAt    DateTime                   @default(now())

  @@index([requestId])
}

model ScooterRegistrationSettings {
  id               String   @id @default("default")
  stripePaymentUrl String?
  updatedAt        DateTime @updatedAt
}
